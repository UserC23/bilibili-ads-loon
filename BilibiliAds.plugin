#!name=哔哩哔哩去广告 Pro
#!desc=v2。修 v1 的卡顿：MITM 只解密 app.bilibili.com 与 api.live.bilibili.com 两个域名，不再拦 api.bilibili.com 上的视频详情与播放地址；停掉每次进视频都要整包改写 634KB 的 relate/story。去广告范围与 v1 一致，但首页刷新和点进视频明显变快。需开启 MITM 并信任证书。
#!author=UserC23
#!homepage=https://github.com/UserC23/bilibili-ads-loon
#!date=2026-10-31
#!category=广告拦截

# ─────────────────────────────────────────────────────────────
# v2 改了什么（只改性能，不减广告拦截范围）
#
#   v1 的问题：你反馈"去广告有效，但首页刷新、点进视频后评论区刷新很慢"。
#   开关插件对比确认是插件导致，所以逐条算了每个被改写响应的体积：
#
#     端点                                 体积      条目   实际广告
#     /x/v2/feed/index/relate/story       634 KB     20       0
#     /x/v2/feed/index/story              233 KB      6       2
#     /x/v2/feed/index                    212 KB     10       0
#     /xlive/app-interface/v2/index/feed  479 KB     24       1
#
#   Loon 的 body 改写必须先把整个响应收完、解析、改完再发出去，
#   期间这条请求不能流式返回。所以规则匹配到的响应越大、越靠前，
#   体感就越卡。620KB 的那条一条广告都没拦到，纯粹是开销。
#
#   于是 v2 做两件事：
#
#   1. relate/story（634 KB，20 条里 0 条广告）默认不再改写，
#      降到文末"可选"区。这是体感最大的一笔。
#
#   2. [MITM] 去掉 api.bilibili.com。
#      这个域名承载视频详情（x/web-interface/view）、播放地址
#      （x/player/wbi/playurl）、页面配置（x/kv-frontend/namespace/data，
#      一份抓包里被调了 16 次）—— 全都是进视频页的必经请求。
#      之前为了拦一条广告上报接口把整条链路都解密了，不划算，
#      那条规则也一并降到"可选"区。
#
#   剩下的改写（feed/index 212KB、story 233KB）是真能删掉广告卡的，
#   保留。如果你宁可首页留广告也要更快，注释掉 D1 即可。
# ─────────────────────────────────────────────────────────────
#
# 三个最容易被写错的地方（也是网上多数 B站规则"装了没效果"的原因）
#
#   1. 开屏广告不在 app.bilibili.com/x/v2/splash 一条接口上，
#      而是 list + show + brand/list + event/list2 四条。
#      list 单次返回 83 条素材、1.7MB，只拦 show 不拦 list 等于没拦。
#      v2 保留：这四条整包拒绝反而是省流量的（不下载 3.5MB 素材）。
#
#   2. 首页信息流里【正常直播卡】也带 ad_info 字段：
#        ad_info = {"resource":1890,"source":1891,"is_ad_loc":true,...}
#      真广告卡才有 "is_ad": true 和 "creative_id"。
#      按 ad_info 是否存在来删 —— 会把正常直播推全删掉。
#
#   3. 竖屏 story 的广告卡是 card_goto = vertical_ad_av，
#      而普通竖屏卡是 vertical_av。差一个 _ad_，正则写松了会误伤。
#
# 使用前提（缺一不可，否则插件一行都不执行）
#   1. Loon 设置 → MitM → 打开开关
#   2. 安装根证书，并在「设置 → 通用 → 关于本机 → 证书信任设置」开启完全信任
#   3. B站上滑彻底杀掉后重开（页面 JSON 有缓存，切后台无效）
# ─────────────────────────────────────────────────────────────

[MITM]
# 只解密这两个域名。
# app.bilibili.com      开屏四条接口 + 首页信息流 + 竖屏 story
# api.live.bilibili.com 直播首页 + 直播间信息
#
# 刻意不列 api.bilibili.com：它承载视频详情、播放地址、页面配置，
# 解密它只会让"点进视频"变慢，换来的只有一条广告上报接口。
# cm.bilibili.com 走 [Rule] 直接 REJECT，不解密，所以也不列在这里。
hostname = app.bilibili.com, api.live.bilibili.com

[Rewrite]
# ═════════════════════════════════════════════════════════════
# A 级｜开屏广告 —— 默认开启
# reject-dict 返回 HTTP 200 + {}，App 解析成「这轮没有开屏」，
# 直接进首页。不会白屏，也不会弹网络异常。
#
# 四条接口缺一不可：
#   list         素材清单（83 条 / 1.7MB，source=928，落地页多为京东/阿里妈妈）
#   show         当天该展示哪一条（带 ad_cb 回执）
#   brand/list   品牌开屏
#   event/list2  开屏曝光事件
#
# 性能提示：这条是"变快"而不是"变慢" —— 不解密、不下载 3.5MB 素材，
# 冷启动反而更快。
#
# 副作用：B站自己的节日开屏（春节/周年庆动画）也一起没了。
# 这是开屏去广告的必然代价，介意就把这一段注释掉。
# ═════════════════════════════════════════════════════════════
^https?://app\.bilibili\.com/x/v2/splash/(list|show|brand/list|event/list2) reject-dict

# ═════════════════════════════════════════════════════════════
# B 级｜竖屏 story 购物车广告锚点 —— 默认开启
# 这个接口整个响应体只有一条东西：data.anchor.ad_info，
# 内容是「红果免费短剧」这类穿山甲（open.snssdk.com）下载广告。
# 没有正常业务数据，所以整包拒绝最干净。响应体只有 12KB，开销可忽略。
# ═════════════════════════════════════════════════════════════
^https?://app\.bilibili\.com/x/v2/feed/index/story/cart(\?|$) reject-dict

# ═════════════════════════════════════════════════════════════
# C 级｜广告位接口 —— 默认开启
# GetWidgetBannerList 是直播间挂件广告位（挂件号位 3615），
# 只服务挂件位，整包拒绝不影响直播间主体。
#
# 注：v1 里还有一条 api.bilibili.com/x/vip/ads/material/report，
# v2 已降到文末"可选"区 —— 它需要把 api.bilibili.com 纳入 MITM，
# 代价是视频详情与播放地址全被解密，只为拦一条上报请求不划算。
# ═════════════════════════════════════════════════════════════
^https?://api\.live\.bilibili\.com/xlive/play-interface/widgetService/GetWidgetBannerList reject-dict

# ═════════════════════════════════════════════════════════════
# D 级｜页面 JSON 清洗 —— 默认开启
# 广告和正常内容在同一个 JSON 里，只能定点删，不能整包拒绝。
# D1/D2 是仅有的两条需要"整包改写"的规则，也仅剩这两条。
# ═════════════════════════════════════════════════════════════

# D1. 首页信息流（/x/v2/feed/index，212KB / 10 条）
#     删卡条件，任一命中：
#       .is_ad == true                      显式广告标记
#       .ad_info.is_ad == true              广告位广告标记
#       .ad_info.creative_id > 0            有创意 ID = 有广告主
#       card_goto / goto 命中 ^ad、_ad_、^vertical_ad
#       card_type 命中 ^ad
#
#     刻意【不】按 .ad_info 是否存在来删：正常直播卡也有 ad_info（只有 is_ad_loc）。
#     已用真实响应验证：这条规则跑完，10 条正常卡片一条不少，
#     6 条竖屏卡里精确删掉 2 条 vertical_ad_av。
#
#     觉得首页滚动还不够顺，就把这一行注释掉 —— 广告卡会回来，
#     但首页刷新不再经过任何 body 改写。
^https?://app\.bilibili\.com/x/v2/feed/index(\?|$) response-body-json-jq 'del(.data.items[]? | select(((.is_ad? // false) == true) or ((.ad_info.is_ad? // false) == true) or ((.ad_info.creative_id? // 0) > 0) or (((.card_goto? // "") | tostring) | test("^ad|_ad_|^vertical_ad")) or (((.goto? // "") | tostring) | test("^ad|_ad_|^vertical_ad")) or (((.card_type? // "") | tostring) | test("^ad"))))'

# D2. 竖屏 story（/x/v2/feed/index/story，233KB / 6 条 / 2 条广告）
#     广告卡特征：card_goto = vertical_ad_av + ad_info.creative_id。
#     用 (\?|$) 与 D1 精确区分，不会互相串。
#
#     注意：这里【只管】feed/index/story，不再带上 relate/story。
#     relate/story 是 634KB 的相关推荐预加载，抓包里 20 条 0 广告，
#     改写它纯亏 —— 已移到文末可选区。
^https?://app\.bilibili\.com/x/v2/feed/index/story(\?|$) response-body-json-jq 'del(.data.items[]? | select(((.is_ad? // false) == true) or ((.ad_info.is_ad? // false) == true) or ((.ad_info.creative_id? // 0) > 0) or (((.card_goto? // "") | tostring) | test("^ad|_ad_|^vertical_ad")) or (((.goto? // "") | tostring) | test("^ad|_ad_|^vertical_ad")) or (((.card_type? // "") | tostring) | test("^ad"))))'

# D3. 直播首页（/xlive/app-interface/v2/index/feed，479KB / 24 张卡）
#     本抓包 24 张卡，其中 2 张是广告/运营位：
#       banner_v2          顶部轮播（5 帧，带 ad_order_id）
#       activity_card_v1   活动卡
#     另外 small_card_v1 里若 is_ad=true 也一并删。
#     副作用：直播首页顶部轮播消失，属于运营位，不影响看播。
#     性能提示：这条只在进直播页时触发，不影响首页与视频页。
# ═════════════════════════════════════════════════════════════
^https?://api\.live\.bilibili\.com/xlive/app-interface/v2/index/feed(\?|$) response-body-json-jq 'del(.data.card_list[]? | select((((.card_type? // "") | tostring) == "banner_v2") or (((.card_type? // "") | tostring) == "activity_card_v1") or ((.card_data.small_card_v1.is_ad? // false) == true)))'

# D4. 直播间信息（/xlive/app-room/v1/index/getInfoByRoom，约 196KB）
#     activity_banner_info 里全是活动位：
#       pendant_banner（号位 3615「假面奇妙夜」）/ top / bottom / superBanner …
#     ad_livegame_info 是直播小游戏广告位。
#     只删这两个字段，房间信息、榜单、礼物面板都不动。
^https?://api\.live\.bilibili\.com/xlive/app-room/v1/index/getInfoByRoom(\?|$) response-body-json-jq 'del(.data.activity_banner_info) | del(.data.ad_livegame_info)'

[Rule]
# ═════════════════════════════════════════════════════════════
# 域名级拦截（不经过 MITM，反而更快）
# cm.bilibili.com 全域只有广告计费/转化，直接 REJECT 比解密后再改更省电。
# ═════════════════════════════════════════════════════════════
DOMAIN,cm.bilibili.com,REJECT

# 本抓包未出现、但 B站接入的第三方广告 SDK（装了会更安静，按需打开）
# DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT
# DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT
# DOMAIN-SUFFIX,ctobsnssdk.com,REJECT
# DOMAIN-SUFFIX,gromore.com,REJECT
# DOMAIN-SUFFIX,open.snssdk.com,REJECT
# DOMAIN-SUFFIX,1rtb.com,REJECT

# ═════════════════════════════════════════════════════════════
# 高级｜默认关闭，按需打开
# ═════════════════════════════════════════════════════════════

# 1. 相关推荐竖屏（/x/v2/feed/index/relate/story，634KB / 20 条）
#    v1 默认开着，v2 默认关掉：这是全插件最大的一个响应体，
#    抓包里 20 条内容 0 条广告，改写它只会让每次进视频更卡。
#    如果你确实在这里刷到过广告，再打开（打开后进视频会慢一截）。
# ^https?://app\.bilibili\.com/x/v2/feed/index/relate/story(\?|$) response-body-json-jq 'del(.data.items[]? | select(((.is_ad? // false) == true) or ((.ad_info.creative_id? // 0) > 0) or (((.card_goto? // "") | tostring) | test("^ad|_ad_|^vertical_ad"))))'

# 2. 大会员页广告素材上报（/x/vip/ads/material/report）
#    要用这条，必须同时把 api.bilibili.com 加回上面的 [MITM] hostname，
#    否则规则不会执行。加回去会让视频详情/播放地址重新走解密。
# ^https?://api\.bilibili\.com/x/vip/ads/material/report reject-dict

# 3. 首页「运营大图」卡（card_goto = banner）。抓包里出现过 1 张，
#    多为大会员/活动推广。删掉首页会更干净，但也可能删掉官方活动入口。
# ^https?://app\.bilibili\.com/x/v2/feed/index(\?|$) response-body-json-jq 'del(.data.items[]? | select(((.card_goto? // "") | tostring) == "banner"))'

# 4. 埋点上报（data.bilibili.com，本抓包 104 条）。
#    不是广告，但占流量、也会把广告曝光一并上报。拦掉不影响观看。
# DOMAIN,data.bilibili.com,REJECT

# 5. 开屏素材图片（i0/i1/i2.hdslb.com 的 sycp_brand 目录）。
#    开屏接口已经拒了，这条只是防止缓存里残留的素材继续占流量。
# ^https?://i[0-9]\.hdslb\.com/bfs/sycp_brand/ reject-img
